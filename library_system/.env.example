# Copy this file to .env and fill in your values
# Never commit .env to version control

SECRET_KEY=your-secret-key-here-change-this
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database
DB_NAME=library_db
DB_USER=root
DB_PASSWORD=
